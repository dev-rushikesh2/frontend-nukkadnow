{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "public/**", "tsconfig*.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig*.json", "karma.conf.js"],
      "outputs": ["coverage/**"]
    },
    "e2e": {
      "dependsOn": ["build"],
      "inputs": ["e2e/**"]
    },
    "lint": {
      "inputs": ["src/**", "eslint.config.mjs"]
    },
    "lint:fix": {
      "inputs": ["src/**", "eslint.config.mjs"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
