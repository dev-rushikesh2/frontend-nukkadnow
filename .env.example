# NukkadNow Frontend Environment Configuration Template
# Only public / safe variables are placed here. Never place secrets in frontend builds.

# API Gateway & Backend Services
API_GATEWAY_URL=http://localhost:3000/api/v1
WS_GATEWAY_URL=ws://localhost:3000/ws

# Client App Hostnames (for local and staging)
CUSTOMER_PWA_HOST=http://localhost:4200
MERCHANT_PORTAL_HOST=http://localhost:4201

# Feature Flags
ENABLE_GEO_AUTODETECT=true
ENABLE_OFFLINE_CACHE=true
ENABLE_AUDIO_CHIMES=true

# Analytics & Telemetry (Public DSNs only)
SENTRY_DSN_CUSTOMER=
SENTRY_DSN_MERCHANT=
OTEL_COLLECTOR_URL=http://localhost:4318/v1/traces

# Locality Defaults (Nagpur pilot)
DEFAULT_CITY=Nagpur
DEFAULT_STATE=Maharashtra
DEFAULT_LATITUDE=21.1458
DEFAULT_LONGITUDE=79.0882
DEFAULT_RADIUS_KM=5.0
